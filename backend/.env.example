# Server
PORT=5000
NODE_ENV=development

# Database (MySQL) - vd: mysql://user:password@localhost:3306/booking_platform
# Chay qua docker-compose (xem DEPLOY.md): host phai la "mysql" (ten service
# trong docker-compose.yml, khong phai "localhost") - vd:
# mysql://root:<MYSQL_ROOT_PASSWORD>@mysql:3306/booking_platform
DATABASE_URL="mysql://root:password@localhost:3306/booking_platform"

# JWT
JWT_SECRET=doi_chuoi_bi_mat_nay_o_production
JWT_EXPIRES_IN=1d

# CORS - domain/IP thuc su phuc vu frontend, o production KHONG duoc de localhost.
CLIENT_URL=http://localhost:5173

# Braintree - dang ky Sandbox account rieng tai sandbox.braintreegateway.com
# de lay key dev/test (KHONG dung key production luc dev). Dat
# BRAINTREE_ENVIRONMENT=production + key that CHI tren server that luc deploy.
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=your_sandbox_merchant_id
BRAINTREE_PUBLIC_KEY=your_sandbox_public_key
BRAINTREE_PRIVATE_KEY=your_sandbox_private_key

# SMTP - dung de gui email xac nhan booking (khach) + bao booking moi (host).
# O production tro toi Postfix chay tren chinh server (xem DEPLOY.md muc
# "Postfix") qua host.docker.internal - khong can SMTP_USER/SMTP_PASSWORD vi
# la relay noi bo, chi may host duoc phep gui qua no. Neu doi sang SMTP
# server ngoai co auth (Gmail, SES...), dien them SMTP_USER/SMTP_PASSWORD.
SMTP_HOST=host.docker.internal
SMTP_PORT=25
SMTP_FROM_EMAIL=bookings@reservesmith.com

# Chan Google (va moi search engine khac) index site qua robots.txt
# (Disallow: /) - MAC DINH DANG CHAN, an toan cho luc con dev/demo. Chi doi
# thanh "true" khi thuc su san sang cho site len Google that (yeu cau Jason
# 18/8: chua muon index luc nay).
SEO_ALLOW_INDEXING=false
