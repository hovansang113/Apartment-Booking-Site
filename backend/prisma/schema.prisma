generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  host
  user
}

enum UserStatus {
  active
  locked
}

enum ListingStatus {
  pending
  approved
  suspended
}

enum BookingStatus {
  pending
  approved
  rejected
  canceled
}

enum CalendarDayStatus {
  blocked
  booked
}

enum CalendarDaySource {
  manual
  ical_sync
  booking
}

enum PaymentStatus {
  simulated_success
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  fullName     String     @map("full_name")
  phone        String?
  role         UserRole   @default(user)
  status       UserStatus @default(active)
  isGuest      Boolean    @default(false) @map("is_guest")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  listings Listing[]
  bookings Booking[]

  @@map("users")
}

model Listing {
  id             String        @id @default(uuid())
  hostId         String        @map("host_id")
  title          String
  description    String?       @db.Text
  category       String?
  address        String?
  latitude       Decimal?      @db.Decimal(10, 7)
  longitude      Decimal?      @db.Decimal(10, 7)
  defaultPrice   Decimal       @map("default_price") @db.Decimal(12, 2)
  status         ListingStatus @default(pending)
  suspendReason  String?       @map("suspend_reason") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  host             User                    @relation(fields: [hostId], references: [id], onDelete: Cascade)
  images           ListingImage[]
  priceOverrides   ListingPriceOverride[]
  calendarDays     ListingCalendar[]
  calendarSyncs    ListingCalendarSync[]
  bookings         Booking[]

  @@index([hostId])
  @@index([status])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model ListingPriceOverride {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  date      DateTime @db.Date
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@map("listing_price_overrides")
}

model Booking {
  id              String        @id @default(uuid())
  listingId       String        @map("listing_id")
  guestId         String        @map("guest_id")
  checkIn         DateTime      @map("check_in") @db.Date
  checkOut        DateTime      @map("check_out") @db.Date
  totalPrice      Decimal       @map("total_price") @db.Decimal(12, 2)
  status          BookingStatus @default(approved)
  contactName     String        @map("contact_name")
  contactEmail    String        @map("contact_email")
  contactPhone    String?       @map("contact_phone")
  rejectedReason  String?       @map("rejected_reason") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  approvedAt      DateTime?     @map("approved_at")
  canceledAt      DateTime?     @map("canceled_at")

  listing        Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest          User              @relation(fields: [guestId], references: [id], onDelete: Cascade)
  calendarDays   ListingCalendar[]
  payment        Payment?

  @@index([listingId])
  @@index([guestId])
  @@index([status])
  @@map("bookings")
}

model ListingCalendar {
  id        String            @id @default(uuid())
  listingId String            @map("listing_id")
  date      DateTime          @db.Date
  status    CalendarDayStatus
  source    CalendarDaySource @default(manual)
  note      String?           @db.Text
  bookingId String?           @map("booking_id")
  createdAt DateTime          @default(now()) @map("created_at")

  listing Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([listingId, date])
  @@map("listing_calendar")
}

model ListingCalendarSync {
  id            String    @id @default(uuid())
  listingId     String    @map("listing_id")
  icalUrl       String    @map("ical_url")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_calendar_sync")
}

model Payment {
  id          String        @id @default(uuid())
  bookingId   String        @unique @map("booking_id")
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(simulated_success)
  confirmedAt DateTime      @default(now()) @map("confirmed_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}
