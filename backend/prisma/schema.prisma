generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  host
  user
}

enum UserStatus {
  active
  locked
}

enum ListingStatus {
  pending
  approved
  suspended
}

enum BookingStatus {
  pending
  pending_payment
  approved
  confirmed
  rejected
  expired
  canceled
}

enum CalendarDayStatus {
  blocked
  booked
}

enum CalendarDaySource {
  manual
  ical_sync
  booking
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum ListingCategory {
  apartment
  house
  villa
  homestay
  hotel_room
}

enum Amenity {
  wifi
  kitchen
  washer
  air_conditioning
  free_parking
  pool
  tv
  workspace
}

// Loai hinh nop thue - mo phong theo tax classification cua Airbnb (individual
// vs business entity), doi ten cho phu hop boi canh Viet Nam.
enum TaxpayerType {
  individual
  household_business
  company
}

// Mo phong trang thai xac minh thue/giay to cua host, giong Airbnb that
// (khong phai tu van phap ly chinh thuc - chi la UI mo phong cho du an hoc tap).
// unverified -> host chua nop gi. pending -> da nop, cho admin duyet (REQ_03,
// chua co UI duyet that). verified/rejected -> admin da xu ly.
enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String?             @map("password_hash")
  fullName            String              @map("full_name")
  phone               String?
  role                UserRole            @default(user)
  status              UserStatus          @default(active)
  isGuest             Boolean             @default(false) @map("is_guest")
  legalName           String?             @map("legal_name")
  taxId               String?             @map("tax_id")
  taxpayerType        TaxpayerType?       @map("taxpayer_type")
  idNumber            String?             @map("id_number")
  verificationStatus  VerificationStatus  @default(unverified) @map("verification_status")
  verificationNote    String?             @map("verification_note") @db.Text
  bankSortCode        String?             @map("bank_sort_code")
  bankAccountNumber   String?             @map("bank_account_number")
  bankAccountHolder   String?             @map("bank_account_holder")
  lockedReason        String?             @map("locked_reason") @db.Text
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  listings Listing[]
  bookings Booking[]

  @@map("users")
}

model Listing {
  id             String        @id @default(uuid())
  hostId         String        @map("host_id")
  title          String
  description    String?       @db.Text
  category       ListingCategory?
  address        String
  latitude       Decimal?      @db.Decimal(10, 7)
  longitude      Decimal?      @db.Decimal(10, 7)
  weekdayPrice   Decimal       @map("weekday_price") @db.Decimal(12, 2)
  weekendPrice   Decimal       @map("weekend_price") @db.Decimal(12, 2)
  guestCapacity  Int           @map("guest_capacity")
  bedrooms       Int
  beds           Int
  bathrooms      Int
  status         ListingStatus @default(pending)
  suspendReason  String?       @map("suspend_reason") @db.Text
  icalToken      String        @unique @default(uuid()) @map("ical_token")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  host             User                    @relation(fields: [hostId], references: [id], onDelete: Cascade)
  images           ListingImage[]
  amenities        ListingAmenity[]
  priceOverrides   ListingPriceOverride[]
  stayRules        ListingStayRule[]
  calendarDays     ListingCalendar[]
  calendarSyncs    ListingCalendarSync[]
  bookings         Booking[]

  @@index([hostId])
  @@index([status])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model ListingAmenity {
  id        String  @id @default(uuid())
  listingId String  @map("listing_id")
  amenity   Amenity

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, amenity])
  @@map("listing_amenities")
}

model ListingPriceOverride {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  date      DateTime @db.Date
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@map("listing_price_overrides")
}

// "Custom settings" trong modal chan ngay (REQ_12) - so dem toi thieu/toi da
// NEU khach check-in vao dung ngay nay (khop hanh vi min/max nights that cua
// Airbnb - chi ap dung cho ngay check-in, khong phai moi ngay trong chuyen o).
model ListingStayRule {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  date      DateTime @db.Date
  minNights Int?     @map("min_nights")
  maxNights Int?     @map("max_nights")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@map("listing_stay_rules")
}

model Booking {
  id                String        @id @default(uuid())
  listingId         String        @map("listing_id")
  guestId           String        @map("guest_id")
  checkIn           DateTime      @map("check_in") @db.Date
  checkOut          DateTime      @map("check_out") @db.Date
  adultsCount       Int           @default(1) @map("adults_count")
  childrenCount     Int           @default(0) @map("children_count")
  totalPrice        Decimal       @map("total_price") @db.Decimal(12, 2)
  status            BookingStatus @default(approved)
  bookingCode       String        @unique @map("booking_code")
  commissionRate    Decimal       @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount  Decimal       @map("commission_amount") @db.Decimal(12, 2)
  hostPayoutAmount  Decimal       @map("host_payout_amount") @db.Decimal(12, 2)
  paymentExpiresAt  DateTime?     @map("payment_expires_at")
  contactName       String        @map("contact_name")
  contactEmail      String        @map("contact_email")
  contactPhone      String?       @map("contact_phone")
  contactAddress    String?       @map("contact_address")
  contactCity       String?       @map("contact_city")
  contactPostcode   String?       @map("contact_postcode")
  rejectedReason    String?       @map("rejected_reason") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  approvedAt        DateTime?     @map("approved_at")
  canceledAt        DateTime?     @map("canceled_at")

  listing        Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guest          User              @relation(fields: [guestId], references: [id], onDelete: Cascade)
  calendarDays   ListingCalendar[]
  payment        Payment?

  @@index([listingId])
  @@index([guestId])
  @@index([status])
  @@map("bookings")
}

model ListingCalendar {
  id             String            @id @default(uuid())
  listingId      String            @map("listing_id")
  date           DateTime          @db.Date
  status         CalendarDayStatus
  source         CalendarDaySource @default(manual)
  note           String?           @db.Text
  bookingId      String?           @map("booking_id")
  calendarSyncId String?           @map("calendar_sync_id")
  createdAt      DateTime          @default(now()) @map("created_at")

  listing      Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  booking      Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  calendarSync ListingCalendarSync? @relation(fields: [calendarSyncId], references: [id], onDelete: SetNull)

  @@unique([listingId, date])
  @@map("listing_calendar")
}

model ListingCalendarSync {
  id           String    @id @default(uuid())
  listingId    String    @map("listing_id")
  label        String
  icalUrl      String    @map("ical_url") @db.Text
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  listing      Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  calendarDays ListingCalendar[]

  @@map("listing_calendar_sync")
}

// Theo doi 1 giao dich thanh toan Braintree cho 1 booking (1-1). Tach rieng
// khoi Booking vi Booking la vong doi "cho thue" (pending_payment ->
// confirmed/expired/canceled), con Payment la vong doi "giao dich tien"
// (pending -> success/failed, roi co the refunded rieng) - 2 khai niem khac
// nhau du lien quan chat.
// braintreeTransactionId nullable vi khac VNPay (co san txn ref truoc khi
// khach thanh toan) - Braintree chi tra ve transaction id SAU KHI goi
// gateway.transaction.sale() thanh cong (khach nhap the + xac thuc 3DS xong
// FE moi co payment method nonce de goi API nay).
model Payment {
  id                     String        @id @default(uuid())
  bookingId              String        @unique @map("booking_id")
  provider               String        @default("braintree")
  amount                 Decimal       @db.Decimal(12, 2)
  status                 PaymentStatus @default(pending)
  braintreeTransactionId String?       @unique @map("braintree_transaction_id")
  braintreeStatus        String?       @map("braintree_status")
  threeDSecureVerified   Boolean       @default(false) @map("three_d_secure_verified")
  confirmedAt            DateTime?     @map("confirmed_at")
  refundedAt             DateTime?     @map("refunded_at")
  refundAmount           Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  createdAt              DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}
